{
  "name": "x-english",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:extension": "bun run --cwd apps/extension dev",
    "dev:worker": "bun run --cwd apps/worker dev",
    "build:extension": "bun run --cwd apps/extension build",
    "build:worker": "bun run --cwd apps/worker build",
    "zip:extension": "bun run --cwd apps/extension zip",
    "typecheck": "bun run --cwd apps/extension typecheck && bun run --cwd apps/worker typecheck",
    "lint": "bun run --cwd apps/extension lint && bun run --cwd apps/worker lint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "^0.28.0",
    "oxlint": "^1.43.0"
  },
  "packageManager": "bun@1.3.4"
}
